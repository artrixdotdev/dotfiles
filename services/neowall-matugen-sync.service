[Unit]
Description=Sync NeoWall into DMS wallpaper state
PartOf=graphical-session.target
After=graphical-session.target neowall.service
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/nu %h/dotfiles/scripts/neowall-dms-sync.nu
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
