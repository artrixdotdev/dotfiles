[Unit]
Description=Control NeoWall and visual effects for power saving
PartOf=graphical-session.target neowall.service
After=graphical-session.target neowall.service
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/nu %h/dotfiles/scripts/neowall-visibility.nu
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
