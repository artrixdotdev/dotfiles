{
  "cli_default_open_behavior": "new_window",
  "context_servers": {
    "mcp-server-playwright": {
      "enabled": true,
      "remote": false,
      "settings": {}
    },
    "tauri": {
      "command": "npx @hypothesi/tauri-mcp-server",
      "args": [],
      "env": {}
    }
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "kilo": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    }
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_text_threads": false
  },
  "auto_update": false,
  "restore_on_startup": "last_session",
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "project_panel": {
    "dock": "right",
    "folder_icons": true
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
    "enable_keep_preview_on_code_navigation": true
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "file_finder": {
    "file_icons": true
  },
  "lsp": {
    "omnisharp": {
      "binary": {
        "path": "/usr/bin/omnisharp"
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        },
        "checkOnSave": true
      }
    }
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "default": "allow"
    },
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-sonnet-4-6-latest"
    },
    "commit_message_model": {
      "provider": "ollama",
      "model": "qwen3:latest"
    }
  },
  "vim": {
    "use_system_clipboard": "always",
    "toggle_relative_line_numbers": true
  },
  "file_types": {
    ".service": [
      "Git Config"
    ],
    "Hyprland Config": [
      "hyprland.conf",
      "hyprlandd.conf",
      "hyprland.hl",
      "hyprlandd.hl"
    ]
  },
  "vim_mode": true,
  "ui_font_size": 20,
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all"
  },
  "buffer_font_size": 22,
  "ui_font_family": "Readex Pro",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "terminal": {
    "dock": "bottom",
    "font_family": "JetBrainsMono Nerd Font Mono",
    "line_height": "standard",
    "font_features": {
      "ligatures": true
    },
    "font_weight": 600,
    "font_size": 19,
    "blinking": "on"
  },
  "autosave": "on_window_change",
  "theme": {
    "mode": "dark",
    "light": "DankShell Light",
    "dark": "DankShell Dark"
  },
  "languages": {
    "Rust": {
      "formatter": "language_server"
    },
    "QML": {
      "formatter": {
        "external": {
          "command": "qmlformat",
          "arguments": [
            "{buffer_path}"
          ]
        }
      }
    }
  },
  "formatter": "prettier",
  "format_on_save": "on"
}
