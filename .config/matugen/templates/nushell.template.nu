$env.theme = {
    binary: "{{colors.on_surface.default.hex}}"
    block: "{{colors.on_surface.default.hex}}"
    bool: "{{colors.tertiary.default.hex}}"
    cell-path: "{{colors.on_surface.default.hex}}"
    date: "{{colors.primary.default.hex}}"
    duration: "{{colors.on_surface.default.hex}}"
    empty: "{{colors.secondary.default.hex}}"
    filesize: "{{colors.tertiary.default.hex}}"
    float: "{{colors.on_surface.default.hex}}"
    header: { fg: "{{colors.primary.default.hex}}" attr: "b" }
    hints: "{{colors.outline.default.hex}}"
    int: "{{colors.on_surface.default.hex}}"
    leading_trailing_space_bg: { attr: "n" }
    list: "{{colors.on_surface.default.hex}}"
    nothing: "{{colors.on_surface.default.hex}}"
    range: "{{colors.on_surface.default.hex}}"
    record: "{{colors.on_surface.default.hex}}"
    row_index: { fg: "{{colors.primary.default.hex}}" attr: "b" }
    search_result: { fg: "{{colors.on_error.default.hex}}" bg: "{{colors.error.default.hex}}" }
    separator: "{{colors.on_surface.default.hex}}"
    shape_and: { fg: "{{colors.primary.default.hex}}" attr: "b" }
    shape_binary: { fg: "{{colors.primary.default.hex}}" attr: "b" }
    shape_block: { fg: "{{colors.secondary.default.hex}}" attr: "b" }
    shape_bool: "{{colors.tertiary.default.hex}}"
    shape_closure: { fg: "{{colors.primary.default.hex}}" attr: "b" }
    shape_custom: "{{colors.primary.default.hex}}"
    shape_datetime: { fg: "{{colors.tertiary.default.hex}}" attr: "b" }
    shape_directory: "{{colors.tertiary.default.hex}}"
    shape_external: "{{colors.tertiary.default.hex}}"
    shape_external_resolved: { fg: "{{colors.secondary.default.hex}}" attr: "b" }
    shape_externalarg: { fg: "{{colors.primary.default.hex}}" attr: "b" }
    shape_filepath: "{{colors.tertiary.default.hex}}"
    shape_flag: { fg: "{{colors.secondary.default.hex}}" attr: "b" }
    shape_float: { fg: "{{colors.primary.default.hex}}" attr: "b" }
    shape_garbage: { fg: "{{colors.on_error.default.hex}}" bg: "{{colors.error.default.hex}}" attr: "b" }
    shape_glob_interpolation: { fg: "{{colors.tertiary.default.hex}}" attr: "b" }
    shape_globpattern: { fg: "{{colors.tertiary.default.hex}}" attr: "b" }
    shape_int: { fg: "{{colors.primary.default.hex}}" attr: "b" }
    shape_internalcall: { fg: "{{colors.tertiary.default.hex}}" attr: "b" }
    shape_keyword: { fg: "{{colors.tertiary.default.hex}}" attr: "b" }
    shape_list: { fg: "{{colors.tertiary.default.hex}}" attr: "b" }
    shape_literal: "{{colors.secondary.default.hex}}"
    shape_match_pattern: "{{colors.primary.default.hex}}"
    shape_matching_brackets: { attr: "u" }
    shape_nothing: "{{colors.tertiary.default.hex}}"
    shape_operator: "{{colors.secondary_fixed.default.hex}}"
    shape_or: { fg: "{{colors.primary.default.hex}}" attr: "b" }
    shape_pipe: { fg: "{{colors.primary.default.hex}}" attr: "b" }
    shape_range: { fg: "{{colors.secondary_fixed.default.hex}}" attr: "b" }
    shape_raw_string: "{{colors.primary_fixed.default.hex}}"
    shape_record: { fg: "{{colors.tertiary.default.hex}}" attr: "b" }
    shape_redirection: { fg: "{{colors.primary.default.hex}}" attr: "b" }
    shape_signature: { fg: "{{colors.primary.default.hex}}" attr: "b" }
    shape_string: "{{colors.primary.default.hex}}"
    shape_string_interpolation: { fg: "{{colors.tertiary.default.hex}}" attr: "b" }
    shape_table: { fg: "{{colors.secondary.default.hex}}" attr: "b" }
    shape_vardecl: "{{colors.primary.default.hex}}"
    shape_variable: "{{colors.primary.default.hex}}"
    string: "{{colors.on_surface.default.hex}}"
}
