{
   "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
   "author": "Artrix",
   "name": "Matugen",
   "themes": [
      {
         "appearance": "dark",
         "name": "Matugen",
         "style": {
            "background": "{{colors.background.default.hex}}",
            "surface.background": "{{colors.surface.default.hex}}",
            "elevated_surface.background": "{{colors.surface_container.default.hex}}",

            "text": "{{colors.on_background.default.hex}}",
            "text.muted": "{{colors.on_surface_variant.default.hex}}",
            "text.placeholder": "{{colors.outline.default.hex}}",
            "text.disabled": "{{colors.outline.default.hex | set_lightness: -20.0}}",
            "text.accent": "{{colors.primary.default.hex}}",

            "icon": "{{colors.on_surface.default.hex}}",
            "icon.muted": "{{colors.on_surface_variant.default.hex}}",
            "icon.disabled": "{{colors.outline.default.hex}}",
            "icon.placeholder": "{{colors.outline_variant.default.hex}}",
            "icon.accent": "{{colors.primary.default.hex}}",

            "border": "{{colors.outline.default.hex}}",
            "border.variant": "{{colors.outline_variant.default.hex}}",
            "border.focused": "{{colors.primary.default.hex}}",
            "border.selected": "{{colors.primary.default.hex}}",
            "border.disabled": "{{colors.outline.default.hex | set_lightness: -30.0}}",

            "element.background": "{{colors.surface_container_low.default.hex}}",
            "element.hover": "{{colors.surface_container.default.hex}}",
            "element.active": "{{colors.surface_container_high.default.hex}}",
            "element.selected": "{{colors.primary_container.default.hex}}",
            "element.disabled": "{{colors.surface_container_lowest.default.hex}}",

            "ghost_element.background": "{{colors.background.default.hex}}",
            "ghost_element.hover": "{{colors.surface_variant.default.hex}}",
            "ghost_element.active": "{{colors.surface_variant.default.hex}}",
            "ghost_element.selected": "{{colors.primary_container.default.hex}}",
            "ghost_element.disabled": "{{colors.surface_variant.default.hex}}",

            "drop_target.background": "{{colors.primary_container.default.hex}}",

            "status_bar.background": "{{colors.background.default.hex | set_lightness: 6.0}}",
            "title_bar.background": "{{colors.surface_container.default.hex}}",
            "title_bar.inactive_background": "{{colors.surface_container_lowest.default.hex}}",
            "toolbar.background": "{{colors.surface_container.default.hex}}",

            "tab_bar.background": "{{colors.surface_container_lowest.default.hex}}",
            "tab.inactive_background": "{{colors.surface_container_lowest.default.hex}}",
            "tab.active_background": "{{colors.surface_container.default.hex}}",

            "panel.background": "{{colors.surface_container_lowest.default.hex}}",
            "panel.focused_border": "{{colors.primary.default.hex}}",
            "panel.indent_guide": "{{colors.outline_variant.default.hex}}",
            "panel.indent_guide_active": "{{colors.outline.default.hex}}",
            "panel.indent_guide_hover": "{{colors.outline.default.hex | set_lightness: 10.0}}",

            "pane.focused_border": "{{colors.primary.default.hex}}",
            "pane_group.border": "{{colors.outline_variant.default.hex}}",

            "editor.background": "{{colors.background.default.hex}}",
            "editor.foreground": "{{colors.on_background.default.hex}}",
            "editor.gutter.background": "{{colors.background.default.hex}}",
            "editor.subheader.background": "{{colors.surface_container_lowest.default.hex}}",
            "editor.active_line.background": "{{colors.surface_variant.default.hex}}",
            "editor.highlighted_line.background": "{{colors.source_color.default.hex}}",
            "editor.line_number": "{{colors.outline.default.hex}}",
            "editor.active_line_number": "{{colors.on_surface.default.hex}}",
            "editor.invisible": "{{colors.outline_variant.default.hex}}",
            "editor.wrap_guide": "{{colors.outline_variant.default.hex}}",
            "editor.active_wrap_guide": "{{colors.outline.default.hex}}",
            "editor.indent_guide": "{{colors.outline_variant.default.hex}}",
            "editor.indent_guide_active": "{{colors.outline.default.hex}}",
            "editor.document_highlight.read_background": "{{colors.surface_variant.default.hex}}",
            "editor.document_highlight.write_background": "{{colors.surface_variant.default.hex}}",
            "editor.document_highlight.bracket_background": "{{colors.secondary_container.default.hex}}",

            "search.match_background": "{{colors.tertiary_container.default.hex}}",

            "scrollbar.thumb.background": "{{colors.outline_variant.default.hex}}",
            "scrollbar.thumb.hover_background": "{{colors.outline.default.hex}}",
            "scrollbar.thumb.border": "{{colors.outline_variant.default.hex}}",
            "scrollbar.track.background": "{{colors.surface_variant.default.hex}}",
            "scrollbar.track.border": "{{colors.outline_variant.default.hex}}",

            "terminal.background": "{{colors.background.default.hex}}",
            "terminal.foreground": "{{colors.on_background.default.hex}}",
            "terminal.bright_foreground": "{{colors.on_background.default.hex | set_lightness: 20.0}}",
            "terminal.dim_foreground": "{{colors.on_background.default.hex | set_lightness: -30.0}}",
            "terminal.ansi.background": "{{colors.background.default.hex}}",
            "terminal.ansi.black": "{{colors.surface.default.hex}}",
            "terminal.ansi.red": "{{colors.error.default.hex}}",
            "terminal.ansi.green": "{{colors.green.default.hex}}",
            "terminal.ansi.yellow": "{{colors.yellow.default.hex}}",
            "terminal.ansi.blue": "{{colors.blue.default.hex}}",
            "terminal.ansi.magenta": "{{colors.tertiary.default.hex}}",
            "terminal.ansi.cyan": "{{colors.cyan.default.hex}}",
            "terminal.ansi.white": "{{colors.on_surface.default.hex}}",
            "terminal.ansi.bright_black": "{{colors.surface_variant.default.hex}}",
            "terminal.ansi.bright_red": "{{colors.error.default.hex | set_lightness: 20.0}}",
            "terminal.ansi.bright_green": "{{colors.green.default.hex | set_lightness: 20.0}}",
            "terminal.ansi.bright_yellow": "{{colors.yellow.default.hex | set_lightness: 20.0}}",
            "terminal.ansi.bright_blue": "{{colors.blue.default.hex | set_lightness: 20.0}}",
            "terminal.ansi.bright_magenta": "{{colors.tertiary.default.hex | set_lightness: 20.0}}",
            "terminal.ansi.bright_cyan": "{{colors.cyan.default.hex | set_lightness: 20.0}}",
            "terminal.ansi.bright_white": "{{colors.on_background.default.hex}}",
            "terminal.ansi.dim_black": "{{colors.surface_dim.default.hex}}",
            "terminal.ansi.dim_red": "{{colors.error.default.hex | set_lightness: -30.0}}",
            "terminal.ansi.dim_green": "{{colors.green.default.hex | set_lightness: -30.0}}",
            "terminal.ansi.dim_yellow": "{{colors.yellow.default.hex | set_lightness: -30.0}}",
            "terminal.ansi.dim_blue": "{{colors.blue.default.hex | set_lightness: -30.0}}",
            "terminal.ansi.dim_magenta": "{{colors.tertiary.default.hex | set_lightness: -30.0}}",
            "terminal.ansi.dim_cyan": "{{colors.cyan.default.hex | set_lightness: -30.0}}",
            "terminal.ansi.dim_white": "{{colors.on_surface_variant.default.hex}}",

            "error": "{{colors.error.default.hex}}",
            "error.background": "{{colors.error_container.default.hex}}",
            "error.border": "{{colors.error.default.hex}}",

            "warning": "{{colors.tertiary.default.hex}}",
            "warning.background": "{{colors.tertiary_container.default.hex}}",
            "warning.border": "{{colors.yellow.default.hex}}",

            "success": "{{colors.green.default.hex}}",
            "success.background": "{{colors.green_container.default.hex}}",
            "success.border": "{{colors.green.default.hex}}",

            "info": "{{colors.primary.default.hex}}",
            "info.background": "{{colors.primary_container.default.hex}}",
            "info.border": "{{colors.blue.default.hex}}",

            "hint": "{{colors.outline.default.hex}}",
            "hint.background": "{{colors.outline.default.hex}}",
            "hint.border": "{{colors.outline.default.hex}}",

            "predictive": "{{colors.outline.default.hex}}",
            "predictive.background": "{{colors.surface_variant.default.hex}}",
            "predictive.border": "{{colors.outline_variant.default.hex}}",

            "modified": "{{colors.blue.default.hex}}",
            "modified.background": "{{colors.blue_container.default.hex}}",
            "modified.border": "{{colors.blue.default.hex}}",

            "created": "{{colors.green.default.hex}}",
            "created.background": "{{colors.green_container.default.hex}}",
            "created.border": "{{colors.green.default.hex}}",

            "renamed": "{{colors.yellow.default.hex}}",
            "renamed.background": "{{colors.yellow_container.default.hex}}",
            "renamed.border": "{{colors.yellow.default.hex}}",

            "deleted": "{{colors.error.default.hex}}",
            "deleted.background": "{{colors.error_container.default.hex}}",
            "deleted.border": "{{colors.error.default.hex}}",

            "conflict": "{{colors.tertiary.default.hex}}",
            "conflict.background": "{{colors.tertiary_container.default.hex}}",
            "conflict.border": "{{colors.tertiary.default.hex}}",

            "ignored": "{{colors.outline.default.hex | set_lightness: -20.0}}",
            "ignored.background": "{{colors.outline.default.hex}}",
            "ignored.border": "{{colors.outline_variant.default.hex}}",

            "hidden": "{{colors.outline.default.hex | set_lightness: -30.0}}",
            "hidden.background": "{{colors.outline.default.hex}}",
            "hidden.border": "{{colors.outline_variant.default.hex}}",

            "unreachable": "{{colors.outline.default.hex | set_lightness: -40.0}}",
            "unreachable.background": "{{colors.surface_dim.default.hex}}",
            "unreachable.border": "{{colors.outline_variant.default.hex}}",

            "link_text.hover": "{{colors.primary.default.hex | set_lightness: 10.0}}",

            "syntax": {
               "attribute": {
                  "color": "{{colors.red.default.hex}}"
               },
               "boolean": {
                  "color": "{{colors.error.default.hex}}"
               },
               "comment": {
                  "color": "{{colors.outline.default.hex}}",
                  "font_style": "italic"
               },
               "comment.doc": {
                  "color": "{{colors.on_surface_variant.default.hex}}",
                  "font_style": "italic"
               },
               "constant": {
                  "font_weight": 700,
                  "color": "{{colors.source_color.default.hex}}"
               },
               "constructor": {
                  "color": "{{colors.blue.default.hex}}"
               },
               "embedded": {
                  "color": "{{colors.primary.default.hex}}"
               },
               "emphasis": {
                  "font_style": "italic"
               },
               "emphasis.strong": {
                  "font_weight": 700
               },
               "enum": {
                  "color": "{{colors.blue.default.hex}}"
               },
               "function": {
                  "color": "{{colors.blue.default.hex}}"
               },
               "function.method": {
                  "color": "{{colors.blue.default.hex}}"
               },
               "hint": {
                  "color": "{{colors.outline.default.hex}}",
                  "font_weight": 700
               },
               "keyword": {
                  "color": "{{colors.tertiary.default.hex}}"
               },
               "label": {
                  "color": "{{colors.blue.default.hex}}"
               },
               "link_text": {
                  "color": "{{colors.primary.default.hex}}",
                  "font_style": "italic"
               },
               "link_uri": {
                  "color": "{{colors.cyan.default.hex}}"
               },
               "number": {
                  "color": "{{colors.error.default.hex}}"
               },
               "operator": {
                  "color": "{{colors.on_background.default.hex}}"
               },
               "predictive": {
                  "color": "{{colors.outline.default.hex}}",
                  "font_style": "italic"
               },
               "preproc": {
                  "color": "{{colors.primary.default.hex}}"
               },
               "primary": {
                  "color": "{{colors.on_background.default.hex}}"
               },
               "property": {
                  "color": "{{colors.red.default.hex}}"
               },
               "punctuation": {
                  "color": "{{colors.on_surface_variant.default.hex}}"
               },
               "punctuation.bracket": {
                  "color": "{{colors.on_surface_variant.default.hex}}"
               },
               "punctuation.delimiter": {
                  "color": "{{colors.on_surface_variant.default.hex}}"
               },
               "punctuation.list_marker": {
                  "color": "{{colors.on_surface.default.hex}}"
               },
               "punctuation.special": {
                  "color": "{{colors.tertiary.default.hex}}"
               },
               "string": {
                  "color": "{{colors.tertiary.default.hex}}"
               },
               "string.escape": {
                  "color": "{{colors.cyan.default.hex}}"
               },
               "string.regex": {
                  "color": "{{colors.cyan.default.hex}}"
               },
               "string.special": {
                  "color": "{{colors.cyan.default.hex}}"
               },
               "string.special.symbol": {
                  "color": "{{colors.green.default.hex}}"
               },
               "tag": {
                  "color": "{{colors.red.default.hex}}"
               },
               "text.literal": {
                  "color": "{{colors.green.default.hex}}"
               },
               "title": {
                  "color": "{{colors.primary.default.hex}}",
                  "font_weight": 700
               },
               "type": {
                  "color": "{{colors.primary.default.hex}}"
               },
               "variable": {
                  "color": "{{colors.on_surface.default.hex}}"
               },
               "variable.special": {
                  "color": "{{colors.primary.default.hex}}"
               },
               "variant": {
                  "color": "{{colors.blue.default.hex}}"
               }
            },

            "players": [
               {
                  "background": "{{colors.primary.default.hex}}",
                  "cursor": "{{colors.primary.default.hex}}",
                  "selection": "{{colors.primary.default.hex}}"
               },
               {
                  "background": "{{colors.secondary.default.hex}}",
                  "cursor": "{{colors.secondary.default.hex}}",
                  "selection": "{{colors.secondary.default.hex}}"
               },
               {
                  "background": "{{colors.tertiary.default.hex}}",
                  "cursor": "{{colors.tertiary.default.hex}}",
                  "selection": "{{colors.tertiary.default.hex}}"
               },
               {
                  "background": "{{colors.error.default.hex}}",
                  "cursor": "{{colors.error.default.hex}}",
                  "selection": "{{colors.error.default.hex}}"
               },
               {
                  "background": "{{colors.blue.default.hex}}",
                  "cursor": "{{colors.blue.default.hex}}",
                  "selection": "{{colors.blue.default.hex}}"
               },
               {
                  "background": "{{colors.green.default.hex}}",
                  "cursor": "{{colors.green.default.hex}}",
                  "selection": "{{colors.green.default.hex}}"
               },
               {
                  "background": "{{colors.yellow.default.hex}}",
                  "cursor": "{{colors.yellow.default.hex}}",
                  "selection": "{{colors.yellow.default.hex}}"
               },
               {
                  "background": "{{colors.cyan.default.hex}}",
                  "cursor": "{{colors.cyan.default.hex}}",
                  "selection": "{{colors.cyan.default.hex}}"
               }
            ]
         }
      }
   ]
}
