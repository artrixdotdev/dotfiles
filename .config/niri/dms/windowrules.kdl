// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1776924902063059761 @name=vesktop
window-rule {
    match app-id="^vesktop$"
    open-maximized true
}

// @id=wr_1776969083156305750 @name=Surfshark
window-rule {
    match app-id="^Surfshark$"
    open-maximized true
    open-on-workspace "monitor"
}

// @id=wr_1783747027240740646 @name=org.gnome.Nautilus
window-rule {
    match app-id="^org.gnome.Nautilus$"
    background-effect {
        blur true
        xray true
    }
}

// @id=wr_1783747145807715527 @name=Bitwarden
window-rule {
    match title="^Bitwarden$"
    open-floating true
    open-focused true
    default-column-width { fixed 800; }
    default-window-height { fixed 800; }
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}
